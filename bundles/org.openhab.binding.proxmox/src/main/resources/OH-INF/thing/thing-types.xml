<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="proxmox"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0 https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<bridge-type id="host">
		<label>Proxmox Host</label>
		<description>The Proxmox VE host acting as the bridge to its nodes, VMs and containers</description>

		<config-description>
			<parameter name="baseUrl" type="text" required="true">
				<label>Host URL</label>
				<description>The base URL of the Proxmox VE API, e.g. https://pve:8006/</description>
				<context>url</context>
			</parameter>

			<parameter name="username" type="text" required="true">
				<label>User Name</label>
				<description>User name for the Proxmox REST API including the realm, e.g. openhab@pam. Must have the proper access
					rights.</description>
			</parameter>

			<parameter name="password" type="text" required="true">
				<label>Password</label>
				<description>Password for the Proxmox REST API.</description>
				<context>password</context>
			</parameter>

			<parameter name="macAddress" type="text" required="false">
				<label>MAC Address</label>
				<description>If the MAC address of the host is entered here, the binding will attempt to power on the host via Wake
					on LAN (WOL) when it receives an ON command on the power channel of a node. Accepted value is six groups of two
					hexadecimal digits, separated by hyphens or colons, e.g. '3c:cd:93:c2:20:e0'. If left empty, the binding tries to
					auto-detect it via ARP.</description>
			</parameter>

			<parameter name="pollingInterval" type="integer" min="1" step="1" unit="s">
				<label>Polling Interval</label>
				<description>Seconds between fetching values from the Proxmox API.</description>
				<default>30</default>
			</parameter>
		</config-description>
	</bridge-type>

	<thing-type id="node">
		<supported-bridge-type-refs>
			<bridge-type-ref id="host"/>
		</supported-bridge-type-refs>

		<label>Proxmox Node</label>
		<description>A node (physical host) of a Proxmox VE (cluster)</description>

		<channels>
			<channel id="power" typeId="system.power"/>
			<channel id="status" typeId="status"/>
			<channel id="cpu-load" typeId="cpu-load"/>
			<channel id="memory-used" typeId="memory-used"/>
			<channel id="memory-total" typeId="memory-total"/>
			<channel id="disk-used" typeId="disk-used"/>
			<channel id="disk-total" typeId="disk-total"/>
			<channel id="uptime" typeId="uptime"/>
		</channels>

		<representation-property>name</representation-property>
	</thing-type>

	<thing-type id="vm">
		<supported-bridge-type-refs>
			<bridge-type-ref id="host"/>
		</supported-bridge-type-refs>

		<label>Proxmox VM</label>
		<description>A QEMU virtual machine of a Proxmox VE node</description>

		<channels>
			<channel id="power" typeId="system.power"/>
			<channel id="status" typeId="status"/>
			<channel id="cpu-load" typeId="cpu-load"/>
			<channel id="memory-used" typeId="memory-used"/>
			<channel id="memory-total" typeId="memory-total"/>
			<channel id="disk-total" typeId="disk-total"/>
			<channel id="uptime" typeId="uptime"/>
		</channels>

		<representation-property>id</representation-property>
	</thing-type>

	<thing-type id="lxc">
		<supported-bridge-type-refs>
			<bridge-type-ref id="host"/>
		</supported-bridge-type-refs>

		<label>Proxmox LXC</label>
		<description>A Linux container (LXC) of a Proxmox VE node</description>

		<channels>
			<channel id="power" typeId="system.power"/>
			<channel id="status" typeId="status"/>
			<channel id="cpu-load" typeId="cpu-load"/>
			<channel id="memory-used" typeId="memory-used"/>
			<channel id="memory-total" typeId="memory-total"/>
			<channel id="disk-used" typeId="disk-used"/>
			<channel id="disk-total" typeId="disk-total"/>
			<channel id="uptime" typeId="uptime"/>
		</channels>

		<representation-property>id</representation-property>
	</thing-type>

	<channel-type id="status">
		<item-type>String</item-type>
		<label>Status</label>
		<description>The current status reported by Proxmox VE (e.g. running, stopped, online, offline)</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="cpu-load">
		<item-type unitHint="%">Number:Dimensionless</item-type>
		<label>CPU Load</label>
		<description>The current CPU load</description>
		<state readOnly="true" pattern="%.1f %%"/>
	</channel-type>

	<channel-type id="memory-used">
		<item-type>Number:DataAmount</item-type>
		<label>Memory Used</label>
		<description>The currently used memory</description>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="memory-total">
		<item-type>Number:DataAmount</item-type>
		<label>Memory Total</label>
		<description>The maximum available memory</description>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="disk-used">
		<item-type>Number:DataAmount</item-type>
		<label>Disk Used</label>
		<description>The currently used disk space</description>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="disk-total">
		<item-type>Number:DataAmount</item-type>
		<label>Disk Total</label>
		<description>The maximum available disk space</description>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="uptime">
		<item-type>Number:Time</item-type>
		<label>Uptime</label>
		<description>The time elapsed since the last boot</description>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

</thing:thing-descriptions>
